{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022"
        ],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "noEmit": false,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@db/*": [
                "./src/db/*"
            ],
            "@modules/*": [
                "./src/modules/*"
            ],
            "@shared/*": [
                "./src/shared/*"
            ],
            "@config/*": [
                "./src/config/*"
            ]
        },
        "baseUrl": "."
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/tests"
    ]
}