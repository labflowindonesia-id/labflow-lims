<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quotation - {{quotationNumber}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 11pt;
            color: #333;
            line-height: 1.4;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #0066cc;
        }
        .logo {
            font-size: 24pt;
            font-weight: bold;
            color: #0066cc;
        }
        .logo-subtitle {
            font-size: 10pt;
            color: #666;
        }
        .document-title {
            text-align: right;
        }
        .document-title h1 {
            font-size: 22pt;
            color: #333;
            margin-bottom: 5px;
        }
        .document-number {
            font-size: 12pt;
            color: #666;
        }
        .info-section {
            display: flex;
            justify-content: space-between;
            margin-bottom: 25px;
        }
        .info-box {
            flex: 1;
        }
        .info-box h3 {
            font-size: 10pt;
            color: #666;
            text-transform: uppercase;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }
        .info-box p {
            font-size: 11pt;
            margin-bottom: 3px;
        }
        .info-box .name {
            font-weight: bold;
            font-size: 12pt;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
        }
        th {
            background: #0066cc;
            color: white;
            padding: 10px 8px;
            text-align: left;
            font-weight: 600;
            font-size: 10pt;
        }
        th:first-child {
            width: 40px;
            text-align: center;
        }
        th:last-child {
            text-align: right;
            width: 120px;
        }
        th:nth-last-child(2) {
            text-align: center;
            width: 80px;
        }
        th:nth-last-child(3) {
            text-align: right;
            width: 120px;
        }
        td {
            padding: 10px 8px;
            border-bottom: 1px solid #eee;
            vertical-align: top;
        }
        td:first-child {
            text-align: center;
            color: #666;
        }
        td:last-child {
            text-align: right;
            font-weight: 500;
        }
        td:nth-last-child(2) {
            text-align: center;
        }
        td:nth-last-child(3) {
            text-align: right;
        }
        tr:nth-child(even) {
            background: #f9f9f9;
        }
        .totals {
            width: 300px;
            margin-left: auto;
            margin-bottom: 25px;
        }
        .totals-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }
        .totals-row.total {
            border-bottom: 2px solid #0066cc;
            font-size: 14pt;
            font-weight: bold;
            color: #0066cc;
            padding-top: 12px;
        }
        .notes {
            background: #f5f5f5;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 25px;
        }
        .notes h3 {
            font-size: 10pt;
            color: #666;
            margin-bottom: 8px;
        }
        .notes p {
            font-size: 10pt;
            color: #555;
        }
        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
        }
        .signature-section {
            display: flex;
            justify-content: space-between;
        }
        .signature-box {
            text-align: center;
            width: 200px;
        }
        .signature-box .label {
            font-size: 9pt;
            color: #666;
            margin-bottom: 50px;
        }
        .signature-box .line {
            border-top: 1px solid #333;
            padding-top: 5px;
            font-weight: 500;
        }
        .validity {
            text-align: center;
            color: #666;
            font-size: 10pt;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <div class="logo">LabFlow</div>
            <div class="logo-subtitle">Laboratory Information Management System</div>
        </div>
        <div class="document-title">
            <h1>QUOTATION</h1>
            <div class="document-number">{{quotationNumber}}</div>
        </div>
    </div>

    <div class="info-section">
        <div class="info-box">
            <h3>Bill To</h3>
            <p class="name">{{customer.name}}</p>
            {{#if customer.address}}<p>{{customer.address}}</p>{{/if}}
            {{#if customer.contactPerson}}<p>Attn: {{customer.contactPerson}}</p>{{/if}}
            {{#if customer.email}}<p>{{customer.email}}</p>{{/if}}
        </div>
        <div class="info-box" style="text-align: right;">
            <h3>Quotation Details</h3>
            <p><strong>Date:</strong> {{formatDate date}}</p>
            <p><strong>Valid Until:</strong> {{formatDate validUntil}}</p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>Parameter / Test</th>
                <th>Method</th>
                <th>Unit Price</th>
                <th>Qty</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            {{#each items}}
            <tr>
                <td>{{no}}</td>
                <td>{{parameterName}}</td>
                <td>{{methodName}}</td>
                <td>{{formatCurrency price}}</td>
                <td>{{quantity}}</td>
                <td>{{formatCurrency subtotal}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <div class="totals">
        <div class="totals-row">
            <span>Subtotal:</span>
            <span>{{formatCurrency subtotal}}</span>
        </div>
        {{#if discount}}
        <div class="totals-row">
            <span>Discount:</span>
            <span>- {{formatCurrency discount}}</span>
        </div>
        {{/if}}
        {{#if tax}}
        <div class="totals-row">
            <span>Tax (11%):</span>
            <span>{{formatCurrency tax}}</span>
        </div>
        {{/if}}
        <div class="totals-row total">
            <span>Total:</span>
            <span>{{formatCurrency total}}</span>
        </div>
    </div>

    {{#if notes}}
    <div class="notes">
        <h3>Notes & Terms</h3>
        <p>{{notes}}</p>
    </div>
    {{/if}}

    <div class="footer">
        <div class="signature-section">
            <div class="signature-box">
                <div class="label">Prepared By</div>
                <div class="line">{{preparedBy}}</div>
            </div>
            <div class="signature-box">
                <div class="label">Customer Approval</div>
                <div class="line">____________________</div>
            </div>
        </div>
        <div class="validity">
            This quotation is valid until {{formatDate validUntil}}
        </div>
    </div>
</body>
</html>
