<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certificate of Analysis - {{reportNumber}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 10pt;
            color: #333;
            line-height: 1.4;
            position: relative;
        }

        /* Watermark */
            {
                {
                #if watermark
            }
        }

        body::before {
            content: "{{watermark}}";
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            font-size: 100pt;
            font-weight: bold;
            color: rgba(200, 200, 200, 0.3);
            z-index: -1;
            pointer-events: none;
            white-space: nowrap;
        }

            {
                {
                /if
            }
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 3px solid #1a365d;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo {
            font-size: 22pt;
            font-weight: bold;
            color: #1a365d;
        }

        .logo-subtitle {
            font-size: 9pt;
            color: #666;
        }

        .accreditation {
            text-align: right;
            font-size: 8pt;
            color: #666;
        }

        .document-title {
            text-align: center;
            margin-bottom: 20px;
        }

        .document-title h1 {
            font-size: 18pt;
            color: #1a365d;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 5px;
        }

        .document-number {
            font-size: 12pt;
            color: #666;
            font-weight: 500;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .info-box {
            background: #f8fafc;
            padding: 12px;
            border-radius: 5px;
            border-left: 3px solid #1a365d;
        }

        .info-box h3 {
            font-size: 9pt;
            color: #666;
            text-transform: uppercase;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

        .info-box p {
            font-size: 10pt;
            margin-bottom: 3px;
        }

        .info-box .name {
            font-weight: bold;
            font-size: 11pt;
        }

        .sample-info {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 20px;
            background: #e2e8f0;
            padding: 12px;
            border-radius: 5px;
        }

        .sample-item {
            text-align: center;
        }

        .sample-item .label {
            font-size: 8pt;
            color: #666;
            text-transform: uppercase;
        }

        .sample-item .value {
            font-size: 11pt;
            font-weight: 600;
            color: #1a365d;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th {
            background: #1a365d;
            color: white;
            padding: 10px 6px;
            text-align: left;
            font-weight: 600;
            font-size: 9pt;
            text-transform: uppercase;
        }

        th:first-child {
            width: 30px;
            text-align: center;
        }

        th:nth-child(4),
        th:nth-child(5) {
            text-align: center;
        }

        th:last-child {
            text-align: center;
            width: 60px;
        }

        td {
            padding: 8px 6px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 9pt;
        }

        td:first-child {
            text-align: center;
            color: #666;
        }

        td:nth-child(4),
        td:nth-child(5) {
            text-align: center;
        }

        td:last-child {
            text-align: center;
        }

        tr:nth-child(even) {
            background: #f8fafc;
        }

        .status-pass {
            color: #22c55e;
            font-weight: bold;
        }

        .status-fail {
            color: #ef4444;
            font-weight: bold;
        }

        .conformity-statement {
            background: #ecfdf5;
            border: 1px solid #22c55e;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .conformity-statement h3 {
            font-size: 10pt;
            color: #166534;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .conformity-statement p {
            font-size: 10pt;
            color: #166534;
        }

        .notes {
            background: #f1f5f9;
            padding: 12px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .notes h3 {
            font-size: 9pt;
            color: #666;
            margin-bottom: 8px;
        }

        .notes p {
            font-size: 9pt;
            color: #555;
        }

        .signatures {
            display: flex;
            justify-content: space-around;
            margin-top: 30px;
            padding-top: 20px;
        }

        .signature-box {
            text-align: center;
            width: 180px;
        }

        .signature-image {
            height: 50px;
            margin-bottom: 5px;
        }

        .signature-image img {
            max-height: 50px;
            max-width: 150px;
        }

        .signature-line {
            border-top: 1px solid #333;
            padding-top: 5px;
        }

        .signature-name {
            font-weight: 600;
            font-size: 10pt;
        }

        .signature-role {
            font-size: 8pt;
            color: #666;
        }

        .signature-date {
            font-size: 8pt;
            color: #666;
            margin-top: 5px;
        }

        .footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid #ddd;
            font-size: 8pt;
            color: #666;
            text-align: center;
        }

        .footer p {
            margin-bottom: 3px;
        }

        .disclaimer {
            font-style: italic;
            color: #888;
        }

        /* Draft watermark styling */
            {
                {
                #if isDraft
            }
        }

        .draft-badge {
            position: fixed;
            top: 10px;
            right: 10px;
            background: #dc2626;
            color: white;
            padding: 5px 15px;
            font-weight: bold;
            font-size: 12pt;
            transform: rotate(15deg);
        }

            {
                {
                /if
            }
        }
    </style>
</head>

<body>
    {{#if isDraft}}
    <div class="draft-badge">DRAFT</div>
    {{/if}}

    <div class="header">
        <div class="logo-section">
            <div>
                <div class="logo">LabFlow</div>
                <div class="logo-subtitle">Laboratory Information Management System</div>
            </div>
        </div>
        <div class="accreditation">
            <p>Accredited Laboratory</p>
            <p>ISO/IEC 17025:2017</p>
        </div>
    </div>

    <div class="document-title">
        <h1>Certificate of Analysis</h1>
        <div class="document-number">{{reportNumber}}</div>
        {{#if title}}<p style="margin-top: 5px; color: #666;">{{title}}</p>{{/if}}
    </div>

    <div class="info-grid">
        <div class="info-box">
            <h3>Customer</h3>
            <p class="name">{{customer.name}}</p>
            {{#if customer.address}}<p>{{customer.address}}</p>{{/if}}
        </div>
        <div class="info-box">
            <h3>Sample Information</h3>
            <p><strong>Lab ID:</strong> {{sample.sampleLabId}}</p>
            <p><strong>Name:</strong> {{sample.sampleName}}</p>
            {{#if sample.condition}}<p><strong>Condition:</strong> {{sample.condition}}</p>{{/if}}
        </div>
    </div>

    <div class="sample-info">
        <div class="sample-item">
            <div class="label">Received Date</div>
            <div class="value">{{formatDate sample.receivedDate}}</div>
        </div>
        <div class="sample-item">
            <div class="label">Analysis Date</div>
            <div class="value">{{#if sample.analysisDate}}{{formatDate sample.analysisDate}}{{else}}-{{/if}}</div>
        </div>
        <div class="sample-item">
            <div class="label">Sample Lab ID</div>
            <div class="value">{{sample.sampleLabId}}</div>
        </div>
        <div class="sample-item">
            <div class="label">Report Number</div>
            <div class="value">{{reportNumber}}</div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>Parameter</th>
                <th>Method</th>
                <th>Result</th>
                <th>Unit</th>
                <th>Spec</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {{#each results}}
            <tr>
                <td>{{no}}</td>
                <td>{{parameterName}}</td>
                <td>{{method}}</td>
                <td>{{result}}</td>
                <td>{{unit}}</td>
                <td>{{specification}}</td>
                <td>
                    {{#if status}}
                    <span class="{{#if (eq status 'PASS')}}status-pass{{else}}status-fail{{/if}}">
                        {{status}}
                    </span>
                    {{/if}}
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    {{#if conformityStatement}}
    <div class="conformity-statement">
        <h3>Conformity Statement</h3>
        <p>{{conformityStatement}}</p>
    </div>
    {{/if}}

    {{#if notes}}
    <div class="notes">
        <h3>Notes</h3>
        <p>{{notes}}</p>
    </div>
    {{/if}}

    {{#if signatures}}
    <div class="signatures">
        {{#each signatures}}
        <div class="signature-box">
            <div class="signature-image">
                {{#if signatureImage}}
                <img src="{{signatureImage}}" alt="Signature" />
                {{/if}}
            </div>
            <div class="signature-line">
                <div class="signature-name">{{name}}</div>
                <div class="signature-role">{{role}}</div>
                {{#if date}}<div class="signature-date">{{formatDate date}}</div>{{/if}}
            </div>
        </div>
        {{/each}}
    </div>
    {{/if}}

    <div class="footer">
        <p>This certificate is electronically generated and is valid without physical signature.</p>
        <p class="disclaimer">
            The results relate only to the samples tested.
            This certificate shall not be reproduced except in full without written approval.
        </p>
    </div>
</body>

</html>